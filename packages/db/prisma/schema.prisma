// The data model for the entire app. Boilerplate — empty schema with no models.
// Example branches add their own models, enums, and migrations here.

generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?
  accounts      Account[]
  sessions      Session[]
  cookbooks     Cookbook[]
  recipes       Recipe[]
  savedRecipes  SavedRecipe[]
  generatedRecipes GeneratedRecipe[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cookbook {
  id        String  @id @default(cuid())
  name      String
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipe {
  id            String  @id @default(cuid())
  name          String
  servings      Int
  instructions  String[]
  user          User[]
  ingredients   Ingredient[]
  components    Component[]
  equipment     Equipment[]
}

model SavedRecipe {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String
  title       String
  recipe      Json?
  sourceVideo String?
  generatedRecipeId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedRecipe GeneratedRecipe? @relation(fields: [generatedRecipeId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@unique([userId, generatedRecipeId])
  @@index([userId, createdAt])
}

enum VideoSourceType {
  LINK
  UPLOAD
}

enum RecipeExtractionStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum RecipeVisibility {
  PRIVATE
  PUBLIC
}

model VideoSource {
  id              String                  @id @default(cuid())
  sourceType      VideoSourceType
  platform        String?
  originalUrl     String?                 @db.Text
  canonicalUrl    String?                 @db.Text
  videoId         String?
  sourcePlatform  String?
  sourceVideoUrl  String?                 @db.Text
  sourceVideoId   String?
  sourceCreatorUsername String?
  sourceCreatorName String?
  sourceCreatorProfileUrl String?         @db.Text
  sourceHash      String                  @unique
  uploadBlobKey   String?
  status          RecipeExtractionStatus  @default(QUEUED)
  errorMessage    String?                 @db.Text
  requestedById   String?
  accessTokenHash String?
  attempts        Int                     @default(0)
  createdAt       DateTime                @default(now())
  lastProcessedAt DateTime?
  statusUpdatedAt DateTime                @default(now())
  generatedRecipe GeneratedRecipe?

  @@index([platform, videoId])
}

model GeneratedRecipe {
  id              String           @id @default(cuid())
  videoSourceId   String           @unique
  ownerId         String?
  title           String
  recipe          Json
  transcript      String?          @db.Text
  ocrCandidates   Json?
  model           String?
  coverImageKey   String?
  visibility      RecipeVisibility @default(PRIVATE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  videoSource     VideoSource      @relation(fields: [videoSourceId], references: [id], onDelete: Cascade)
  owner           User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  bookmarks       SavedRecipe[]

  @@index([visibility, createdAt])
  @@index([ownerId, createdAt])
}

model Component {
  id        String  @id @default(cuid())
  name      String
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Equipment {
  id        String @id @default(cuid())
  name      String
  settings  String?
  optional  Boolean
  recipe    Recipe[]
}

enum Unit {
  TEASPOON 
  TABLESPOON 
  CUP 
  FLUID_OUNCE 
  OUNCE 
  POUND 
  GRAM 
  KILOGRAM 
  MILLILITER 
  LITER 
  PIECE 
  CLOVE 
  SLICE 
  CAN 
  PACKAGE 
  PINCH 
  DASH 
  NONE
}

model Ingredient {
  id            String  @id @default(cuid())
  name          String
  amount        Float
  unit          Unit  @default(NONE)
  calories      Float
  carbohydrates Float
  protein       Float
  fats          Float
  optional      Boolean  
  recipe        Recipe[]
}